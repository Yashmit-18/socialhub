# Copy to apps/api/.env and fill in. Generate secrets with: npm run secrets
NODE_ENV=development
PORT=4000
LOG_LEVEL=

# A replica set enables multi-document transactions (docker-compose and Atlas provide one).
MONGODB_URI=mongodb://127.0.0.1:27017/socialhub?replicaSet=rs0
# Auto-build indexes on startup (defaults to true outside production). In production run `npm run db:indexes -w @socialhub/api`.
MONGODB_AUTO_INDEX=

# Comma-separated browser origins allowed by CORS. The first is used for links in emails.
CLIENT_ORIGIN=http://localhost:5173
# Public URL of the web app, if different from the first CLIENT_ORIGIN.
APP_URL=
# Set when running behind a reverse proxy / load balancer (e.g. 1, or true).
TRUST_PROXY=

# --- Auth ---
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=20
BCRYPT_ROUNDS=12
# Defaults: secure in production; SameSite=lax. Use SameSite=none (+secure) only if web and API are on different sites.
COOKIE_SECURE=
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
PASSWORD_RESET_TTL_MINUTES=30
INVITATION_TTL_DAYS=7

# --- Encryption of third-party tokens at rest (32 bytes, base64) ---
TOKEN_ENCRYPTION_KEY=

# --- Rate limits ---
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=30
API_RATE_LIMIT_PER_MINUTE=300

# --- Email (optional). Without SMTP, emails are logged instead of delivered. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SocialHub <no-reply@example.com>

# Serve the built web app (apps/web/dist) from the API for single-origin deployments.
SERVE_WEB_DIST=

# Monitoring: GET /api/v1/health/details (version, database, queues, workers) answers only
# with "Authorization: Bearer <HEALTH_DETAILS_TOKEN>". Leave empty to turn that route off; the
# public /api/v1/health then only says whether the API and its database are up.
# Generate one with: npm run secrets
HEALTH_DETAILS_TOKEN=

# --- Publishing engine (Phase 5): BullMQ on Redis. ---
# Redis is required to queue posts. Without REDIS_URL, or while Redis is down, publishing
# answers 503 QUEUE_UNAVAILABLE and nothing is queued. There is no in-memory substitute.
# Local Redis: `docker compose up -d redis`, or see README "Publishing engine" for Windows.
# After setting it, check the connection with: npm run queue:verify -w @socialhub/api
REDIS_URL=
# disabled  = jobs cannot be created (default)
# simulated = development only: the whole engine runs, but NOTHING is sent to Facebook or
#             Instagram, and no post id is ever recorded. Refused when NODE_ENV=production.
# Real publishing is not enabled in this build, so there is no "live" value.
PUBLISHING_MODE=disabled
# The API runs the publish worker itself. Set false when `npm run worker` runs it instead.
PUBLISHING_WORKER_INLINE=true
PUBLISHING_CONCURRENCY=5
# Automatic attempts per account (including the first); the delay doubles each time.
PUBLISHING_MAX_ATTEMPTS=4
PUBLISHING_RETRY_BASE_SECONDS=30
# Recovery after a worker stops: an account still "publishing" after CLAIM seconds is marked
# interrupted (never repeated automatically); a waiting account REQUEUE seconds overdue gets
# a new queue entry. The sweep runs every RECOVERY_INTERVAL seconds.
PUBLISHING_CLAIM_SECONDS=900
PUBLISHING_REQUEUE_SECONDS=120
PUBLISHING_RECOVERY_INTERVAL_SECONDS=60

# --- Meta integration (Phase 2). Leave blank to keep the integration disabled. ---
# Public HTTPS base URL where Meta reaches this API (OAuth redirect + callbacks). Defaults to APP_URL.
API_PUBLIC_URL=
# Facebook Login: App ID and App Secret from Meta App Dashboard > App settings > Basic.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v27.0
# Facebook Login for Business configuration ID (optional). When set, it replaces META_FACEBOOK_SCOPES.
META_FACEBOOK_LOGIN_CONFIG_ID=
META_FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish
# Optional additions: business_management (Business Manager API use cases), ads_management,ads_read (Phase 4: publishing to Instagram when the Page role comes from Business Manager).
# Instagram API with Instagram Login: the *Instagram* app ID/secret (Instagram > API setup), not the Meta app ID.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish
META_OAUTH_STATE_TTL_MINUTES=10
META_REQUEST_TIMEOUT_MS=15000

# --- Media storage for the composer (Phase 4). Leave STORAGE_DRIVER blank to keep uploads disabled. ---
# s3    = S3-compatible object storage (AWS S3, Cloudflare R2, MinIO). Use this in production.
# local = files on this server's disk, uploaded to and served by this API. Development only:
#         its URLs are only as public as this API, so Instagram cannot fetch them from localhost.
STORAGE_DRIVER=
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=us-east-1
# Only for non-AWS providers, e.g. https://<account>.r2.cloudflarestorage.com
STORAGE_S3_ENDPOINT=
# Key permissions: s3:PutObject, s3:GetObject, s3:DeleteObject on the objects and
# s3:ListBucket on the bucket (see docs/COMPOSER_API_CONTRACT.md, "Setting up the bucket").
# These two values must never be copied into apps/web/.env.
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# true for MinIO and most custom endpoints (the default when an endpoint is set).
STORAGE_S3_FORCE_PATH_STYLE=
# Public HTTPS base URL of the bucket or the CDN in front of it. Meta fetches media from it.
STORAGE_PUBLIC_BASE_URL=
# Directory for STORAGE_DRIVER=local: an absolute path, or a path relative to apps/api.
# It is created at start. Keep it outside the Git repository (./storage-data is git-ignored).
# Quote paths that contain spaces, and use forward slashes on Windows, for example:
#   STORAGE_LOCAL_DIR="F:/Social Hub Data"
# Local files cannot be fetched by Meta, so they can never be used for real publishing.
STORAGE_LOCAL_DIR=./storage-data
# After configuring, check the bucket with: npm run storage:verify -w @socialhub/api
# How long an upload link stays valid.
STORAGE_UPLOAD_TTL_SECONDS=900
