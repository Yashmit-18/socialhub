# Copy to apps/api/.env and fill in. Generate secrets with: npm run secrets
NODE_ENV=development
PORT=4000
LOG_LEVEL=

# A replica set enables multi-document transactions (docker-compose and Atlas provide one).
MONGODB_URI=mongodb://127.0.0.1:27017/socialhub?replicaSet=rs0
# Auto-build indexes on startup (defaults to true outside production). In production run `npm run db:indexes -w @socialhub/api`.
MONGODB_AUTO_INDEX=

# Comma-separated browser origins allowed by CORS. The first is used for links in emails.
CLIENT_ORIGIN=http://localhost:5173
# Public URL of the web app, if different from the first CLIENT_ORIGIN.
APP_URL=
# Set when running behind a reverse proxy / load balancer (e.g. 1, or true).
TRUST_PROXY=

# --- Auth ---
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=20
BCRYPT_ROUNDS=12
# Defaults: secure in production; SameSite=lax. Use SameSite=none (+secure) only if web and API are on different sites.
COOKIE_SECURE=
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
PASSWORD_RESET_TTL_MINUTES=30
INVITATION_TTL_DAYS=7

# --- Encryption of third-party tokens at rest (32 bytes, base64) ---
TOKEN_ENCRYPTION_KEY=

# --- Rate limits ---
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=30
API_RATE_LIMIT_PER_MINUTE=300

# --- Email (optional). Without SMTP, emails are logged instead of delivered. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SocialHub <no-reply@example.com>

# Serve the built web app (apps/web/dist) from the API for single-origin deployments.
SERVE_WEB_DIST=

# Reserved for the BullMQ publishing engine (Phase 3). Not used in Phase 1.
# REDIS_URL=redis://127.0.0.1:6379

# --- Meta integration (Phase 2). Leave blank to keep the integration disabled. ---
# Public HTTPS base URL where Meta reaches this API (OAuth redirect + callbacks). Defaults to APP_URL.
API_PUBLIC_URL=
# Facebook Login: App ID and App Secret from Meta App Dashboard > App settings > Basic.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v27.0
# Facebook Login for Business configuration ID (optional). When set, it replaces META_FACEBOOK_SCOPES.
META_FACEBOOK_LOGIN_CONFIG_ID=
META_FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish
# Optional additions: business_management (Business Manager API use cases), ads_management,ads_read (Phase 3: publishing to Instagram when the Page role comes from Business Manager).
# Instagram API with Instagram Login: the *Instagram* app ID/secret (Instagram > API setup), not the Meta app ID.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish
META_OAUTH_STATE_TTL_MINUTES=10
META_REQUEST_TIMEOUT_MS=15000
