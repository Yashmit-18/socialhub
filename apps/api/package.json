{
  "name": "@socialhub/api",
  "version": "0.1.0",
  "private": true,
  "description": "SocialHub REST API (Express + MongoDB).",
  "type": "module",
  "main": "./src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:indexes": "node --env-file-if-exists=.env scripts/sync-indexes.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "meta:sync": "node --env-file-if-exists=.env scripts/sync-meta-connections.js",
    "storage:verify": "node --env-file-if-exists=.env scripts/verify-storage.js",
    "media:cleanup": "node --env-file-if-exists=.env scripts/cleanup-media.js",
    "meta:verify": "node --env-file-if-exists=.env scripts/verify-meta-integration.js"
  },
  "dependencies": {
    "@socialhub/shared": "0.1.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.2",
    "nodemailer": "^10.6.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2"
  }
}
