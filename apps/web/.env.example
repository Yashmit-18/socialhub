# Only needed when the API is NOT reachable at /api on the same origin (e.g. separate hosts).
# VITE_API_URL=https://api.example.com/api/v1
# Dev proxy target for /api (defaults to http://localhost:4000).
# VITE_API_PROXY_TARGET=http://localhost:4000

# --- Composer: use the API instead of this browser (set at build time; all default to off). ---
# Team drafts stored in MongoDB (content packages), with autosave and conflict detection.
# VITE_COMPOSER_SERVER_DRAFTS=true
# Account presets shared with the workspace.
# VITE_COMPOSER_SERVER_PRESETS=true
# Media upload. Also needs STORAGE_DRIVER configured in apps/api/.env.
# VITE_COMPOSER_MEDIA_UPLOAD=true
