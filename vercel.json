{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "index.js",
      "installCommand": "cd ../.. && npm ci"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "cd ../.. && npm ci --include=dev",
      "buildCommand": "npm run build && find dist -name '*.map' -type f -delete",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
      "headers": [
        {
          "source": "/(.*)",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data: https: blob:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests;media-src 'self' blob: https:;connect-src 'self' https://*.r2.cloudflarestorage.com"
            },
            { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
            { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
            { "key": "Origin-Agent-Cluster", "value": "?1" },
            { "key": "Referrer-Policy", "value": "no-referrer" },
            { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-DNS-Prefetch-Control", "value": "off" },
            { "key": "X-Download-Options", "value": "noopen" },
            { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
            { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" },
            { "key": "X-XSS-Protection", "value": "0" }
          ]
        }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
